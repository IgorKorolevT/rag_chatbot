# ============================================
# Environment variables for RAG Chatbot
# Copy this file to .env and fill in values if needed.
# NEVER commit the real .env file to GitHub!
# ============================================

# --- Optional: Hugging Face token (for higher rate limits when downloading models) ---
# Get free token at: https://huggingface.co/settings/tokens
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Optional: if you later want to connect a free/local LLM endpoint ---
# Example for local Ollama (if installed): http://localhost:11434
# LLM_BASE_URL=
# LLM_MODEL=llama3.2

# --- Application settings (defaults are already set in code) ---
# CHUNK_SIZE_MIN=500
# CHUNK_SIZE_MAX=1000
# TOP_K=4
